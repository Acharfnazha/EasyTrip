# Copy this file to .env and fill in your own values.
# .env stays on your computer: it is not committed to Git.

# The port of the website and the API
PORT=3000

# MySQL connection. If your password has a # in it, put the password in quotes.
DB_HOST=localhost
DB_PORT=3306
DB_USER=root
DB_PASSWORD=
DB_NAME=easytrip_db

# The secret used to sign the session cookie. It should be long and random.
# Create one with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
SESSION_SECRET=
