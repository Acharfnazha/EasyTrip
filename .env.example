# Copy this file to .env and fill in your own values.
# .env stays on your computer: it is not committed to Git.

# The port of the website and the API
PORT=3000

# MySQL connection. If your password has a # in it, put the password in quotes.
DB_HOST=localhost
DB_PORT=3306
DB_USER=root
DB_PASSWORD=
DB_NAME=easytrip_db

# The secret used to sign the session cookie. It should be long and random.
# Create one with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
SESSION_SECRET=

# The Gmail account that sends the login codes (see "Email codes" in server/README.md).
# GMAIL_APP_PASSWORD is a 16-letter "app password" made at
# https://myaccount.google.com/apppasswords (the account needs 2-Step Verification).
# It is NOT your normal Gmail password. While these two are empty, the code is only
# printed in the server's terminal.
GMAIL_USER=
GMAIL_APP_PASSWORD=

# "Continue with Google" (see "Google sign-in" in server/README.md). Make an OAuth client
# of the type "Web application" at https://console.cloud.google.com/apis/credentials and
# give it this redirect address: http://localhost:3000/api/auth/google/callback
# While these two are empty, the Google button says that it isn't set up.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# The site's address, written in the emails ("see it on your account page: ..."). Leave it empty
# on your own computer: http://localhost and the port above are used.
SITE_URL=

# true (or empty): only a user whose identity an admin verified can book stays and buy tickets.
# Set it to false to let every logged-in user book (for example while testing).
REQUIRE_VERIFIED_ID=
