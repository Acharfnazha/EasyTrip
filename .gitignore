# EasyTrip — files that stay on your computer and are not committed.
# Everything the site needs (HTML, CSS, JS, images, the server, the database and the docs)
# IS committed.

# Environment and local configuration
.env
.env.*
!.env.example

# IDE and editor settings
.vscode/
.idea/
*.code-workspace
*.sublime-project
*.sublime-workspace
*.swp
*.swo
*~

# Operating-system files
.DS_Store
Thumbs.db
ehthumbs.db
desktop.ini
$RECYCLE.BIN/

# Logs and temporary files
*.log
logs/
tmp/
temp/
*.tmp
*.bak

# Dependencies installed by npm install
vendor/
node_modules/

# Runtime uploads and cache
uploads/
cache/

# Third-party design template (copyright Bedimcode). Kept locally for reference,
# not redistributed in this repository.
docs/template-reference/

# Course documents: the proposal holds a student ID, and the brief is course material.
# Kept locally, not published in this repository.
EasyTrip_Project_Proposal_Web1.docx
Project brief Web Prog 1.pdf
