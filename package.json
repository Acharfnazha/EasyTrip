{
  "name": "easytrip",
  "version": "1.0.0",
  "description": "EasyTrip travel website: Node.js and Express server with a MySQL database",
  "private": true,
  "type": "module",
  "main": "server/server.js",
  "scripts": {
    "start": "node server/server.js",
    "dev": "node --watch server/server.js",
    "test": "node --test"
  },
  "engines": {
    "node": ">=20.11"
  },
  "dependencies": {
    "@tesseract.js-data/ara": "^1.0.0",
    "@tesseract.js-data/eng": "^1.0.0",
    "@vladmandic/face-api": "^1.7.15",
    "bcryptjs": "^3.0.3",
    "dotenv": "^18.0.9",
    "express": "^5.3.0",
    "express-mysql-session": "^3.0.3",
    "express-rate-limit": "^8.7.3",
    "express-session": "^1.19.0",
    "mrz": "^5.0.2",
    "multer": "^2.5.0",
    "mysql2": "^3.24.6",
    "nodemailer": "^10.6.0",
    "tesseract.js": "^7.0.0"
  },
  "overrides": {
    "express-mysql-session": {
      "mysql2": "$mysql2"
    }
  },
  "devDependencies": {
    "nodemon": "^3.1.14"
  }
}
